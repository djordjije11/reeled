<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">
    <changeSet id="1.25.1.0" author="djordjijeradovic24@gmail.com">
        <createTable tableName="lc_author_legacy_author_sync_entry">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_lc_legacy_author_author_sync_entry"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="type" type="VARCHAR(32)"/>
            <column name="bio" type="TEXT"/>
            <column name="image_url" type="VARCHAR(128)"/>
            <column name="legacy_name" type="VARCHAR(255)"/>
            <column name="legacy_type_id" type="BIGINT"/>
            <column name="legacy_bio" type="TEXT"/>
            <column name="legacy_image_url" type="VARCHAR(128)"/>
            <column name="is_legacy" type="BOOLEAN"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
