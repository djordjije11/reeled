<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">
    <changeSet id="1.25.1.0" author="djordjijeradovic24@gmail.com">
        <createTable tableName="a_author">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1001">
                <constraints primaryKey="true" primaryKeyName="pk_a_author"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="bio" type="TEXT"/>
            <column name="image_url" type="VARCHAR(128)"/>
            <column name="is_legacy" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_date" type="TIMESTAMP(6) WITHOUT TIME ZONE"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
